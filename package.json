{
  "name": "tsx-pneumatics",
  "version": "0.0.0",
  "description": "Parametric pneumatic parts and dimensioned drawings in tscircuit TSX",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/tscircuit/tsx-pneumatics",
  "files": [
    "dist/*.js",
    "dist/*.d.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "format:check": "biome format .",
    "test": "bun test",
    "drawings": "bun scripts/export-drawings.tsx"
  },
  "peerDependencies": {
    "react": "19.1.0",
    "tscircuit": "^0.0.3237"
  },
  "dependencies": {
    "@tscircuit/modelprinter": "https://pkg.pr.new/@tscircuit/modelprinter@7a038f3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tscircuit/circuit-json-to-drawing": "https://jscdn.tscircuit.com/@tscircuit/circuit-json-to-drawing/0.0.7.tgz",
    "@types/react": "^19.1.0",
    "bun-types": "^1.4.0",
    "circuit-json-to-gltf": "0.0.166",
    "poppygl": "0.0.39",
    "react": "19.1.0",
    "tscircuit": "0.0.3237",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
